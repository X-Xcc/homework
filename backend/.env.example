# MiMo API配置
MIMO_API_KEY=your_mimo_api_key_here
MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/v1/chat/completions
MIMO_MODEL=mimo-v2.5-pro

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./homework.db

# ChromaDB配置
CHROMA_PERSIST_DIR=./data/vector_db

# 上传文件配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# 应用配置
APP_NAME=法律AI
DEBUG=true

# 鉴权与安全（生产环境务必修改）
JWT_SECRET=change-me-in-production-please
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=14

# CORS 允许来源（逗号分隔；credentials 模式不能用通配）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# 默认管理员种子（首次启动自动创建；创建后可通过 /admin/users 修改密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NICKNAME=系统管理员
